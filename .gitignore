# Go build artifacts
/chatgpt2api
/cmd/server/server
/goldenrecord
*.test

# Python 遗留（重构期间保留，M7 移除）
__pycache__/
*.py[oc]
.venv
# 前端构建产物。目录本身必须存在且被跟踪（.gitkeep）——
# internal/web/dist.go 的 //go:embed all:web_dist 在空目录/缺目录时
# 直接编译失败（pattern all:web_dist: no matching files found），
# 那样全新克隆就无法 go build。
internal/web/web_dist/*
!internal/web/web_dist/.gitkeep
build/
dist/
wheels/
*.egg-info

# 运行时数据
data
config.json
edit

docker-compose-local.yml
.claude/settings.local.json

# 环境变量
.env
.env.local

# 数据库文件
*.db
*.sqlite
*.sqlite3

# Git cache
git_cache/

# 调试/测试输出目录
loginwithpassword_*/
logwithemailverifycode_*/
test_batch_output/
